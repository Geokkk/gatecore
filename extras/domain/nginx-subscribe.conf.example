# 可选: 用 nginx 在 18443 提供 https 订阅链接 (与作者现网同形态)
# 用法: 把占位符换成你的值, 保存为 /etc/nginx/conf.d/subscribe.conf, 然后 nginx -t && systemctl reload nginx
# 占位符: __DOMAIN__ 你的域名 | __SUB_TOKEN__ 自定义一串随机字符 (订阅路径的一部分, 相当于密码)
# 证书直接复用 install-domain.sh 装好的那张。
server {
    listen 18443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /usr/local/etc/xray/tls/fullchain.pem;
    ssl_certificate_key /usr/local/etc/xray/tls/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 订阅地址: https://__DOMAIN__:18443/s/__SUB_TOKEN__
    # 文件内容就是 install-domain.sh 生成的 subscribe.txt (base64 的 vmess 链接)
    location = /s/__SUB_TOKEN__ {
        default_type 'text/plain; charset=utf-8';
        alias /usr/local/etc/xray/subscribe.txt;
    }
    location / { return 404; }
}
